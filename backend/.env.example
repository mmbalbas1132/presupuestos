# Copia este archivo a .env y rellena los valores reales antes de arrancar
# el backend. Nunca subas el archivo .env (con valores reales) al repositorio.

# Clave de acceso que protege toda la API (mínimo 16 caracteres). Sin ella,
# la aplicación no arranca en producción.
ACCESS_KEY=

# Dominio autorizado a hacer peticiones a la API (CORS). Déjalo vacío en
# desarrollo local; en producción, pon la URL pública de la aplicación
# (por ejemplo, https://presupuestos.tudominio.com).
ALLOWED_ORIGIN=

# Pon "true" en producción para exigir HTTPS. Déjalo vacío o "false" en
# desarrollo local.
FORCE_HTTPS=

# Ruta del fichero donde se guarda el registro de auditoría. Si se deja
# vacío, se usa security.log junto al directorio de trabajo del backend.
LOG_PATH=

# Puerto en el que escucha el backend.
PORT=3000

# Ruta del fichero de base de datos SQLite.
DB_PATH=
